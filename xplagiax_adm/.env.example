# ════════════════════════════════════════════════════════════════════════════
#  xplagiax_adm — plantilla de variables de entorno
#
#  Copia como `.env` en esta carpeta. Excluido por .gitignore/.dockerignore —
#  nunca viaja al repo ni a la imagen. En Docker: `docker compose --env-file .env`
#  o `env_file: [.env]` en docker-compose.yml (ya configurado así aquí).
# ════════════════════════════════════════════════════════════════════════════

# ── Flask / sesión ───────────────────────────────────────────────────────────
ADMIN_SECRET_KEY=
ADMIN_SECURITY_SALT=
# DEBE coincidir con ACTIVATION_SIGNING_KEY de xplagiax_appcli2 — ambos
# contenedores firman/verifican el mismo token de activación.
ACTIVATION_SIGNING_KEY=
APPCLI_BASE_URL=https://app.xplagiax.ca

# ── Base de datos (misma instancia MySQL que xplagiax_appcli2) ──────────────
ADMIN_DATABASE_URL=mysql+pymysql://xplagiaxadminuser:xplagiax001@mysql-container:3306/xplagiax_db

# ── Correo (misma cuenta no-reply que xplagiax_appcli2) ─────────────────────
MAIL_SERVER=smtp.ionos.com
MAIL_PORT=587
MAIL_USE_SSL=0
MAIL_USE_TLS=1
MAIL_USERNAME=no-reply@xplagiax.ca
MAIL_PASSWORD=
MAIL_SENDER_NAME=XplagiaX
MAIL_SENDER_ADDR=no-reply@xplagiax.ca

# ── Superadmin de arranque (core/bootstrap_admin.py) ────────────────────────
# Se usa SOLO la primera vez que 'users_admin' está vacía. Rotar la
# contraseña desde el panel después del primer login.
ADMIN_MASTER_EMAIL=no-reply@xplagiax.ca
ADMIN_MASTER_PASSWORD=
